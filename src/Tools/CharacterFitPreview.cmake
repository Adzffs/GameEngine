# Only the developer renderer needs the character-fit atlases.
set(fit_pilot "${CMAKE_CURRENT_SOURCE_DIR}/assets/embervale/custom-character-pilot")
# Graphics::MovementFacing returns these indices for world rendering and occlusion.
set(fit_facings south west east north south-west south-east north-west north-east)
set(fit_includes "")
set(fit_directions "")
foreach(direction IN LISTS fit_facings)
    set(directory "${fit_pilot}/revisions/${direction}-walk-v1")
    if(direction STREQUAL "south")
        set(directory "${fit_pilot}/revisions/shoulder-crest-v6")
    endif()
    set(manifest "${directory}/manifest.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    file(READ "${manifest}" fit_json)
    string(JSON width GET "${fit_json}" cell_size 0)
    string(JSON height GET "${fit_json}" cell_size 1)
    string(JSON pivot_x GET "${fit_json}" ground_pivot 0)
    string(JSON pivot_y GET "${fit_json}" ground_pivot 1)
    foreach(clip IN ITEMS idle walk)
        foreach(field IN ITEMS columns durations_ms)
            string(JSON length LENGTH "${fit_json}" clips ${clip} ${field})
            math(EXPR last "${length} - 1")
            set(values "")
            foreach(index RANGE ${last})
                string(JSON value GET "${fit_json}" clips ${clip} ${field} ${index})
                list(APPEND values "${value}")
            endforeach()
            string(JOIN ", " ${clip}_${field} ${values})
        endforeach()
    endforeach()
    foreach(layer IN ITEMS body tunic full knee)
        if(layer STREQUAL "full" OR layer STREQUAL "knee")
            string(JSON relative GET "${fit_json}" pants_variants ${layer} layer)
        else()
            string(JSON relative GET "${fit_json}" ${layer})
        endif()
        file(RELATIVE_PATH ${layer} "${fit_pilot}" "${directory}/${relative}")
    endforeach()
    if(direction STREQUAL "south")
        # Retained v6 predates the bounds field. Its measured silhouette is x=22..56, y=8..70.
        set(left 22)
        set(right 56)
        set(top 8)
        foreach(field IN ITEMS width height pivot_x pivot_y)
            set(south_${field} "${${field}}")
        endforeach()
    else()
        string(JSON left GET "${fit_json}" silhouette_bounds_inclusive 0)
        string(JSON top GET "${fit_json}" silhouette_bounds_inclusive 1)
        string(JSON right GET "${fit_json}" silhouette_bounds_inclusive 2)
        foreach(field IN ITEMS width height pivot_x pivot_y)
            if(NOT south_${field} EQUAL ${field})
                message(FATAL_ERROR "Character-fit direction ${direction} must share the south ${field}")
            endif()
        endforeach()
    endif()
    string(REPLACE "-" "_" id "${direction}")
    set(binding "CharacterFit-${direction}.inc")
    configure_file(src/Tools/CharacterFitDirection.inc.in "${CMAKE_CURRENT_BINARY_DIR}/${binding}" @ONLY)
    string(APPEND fit_includes "#include \"${binding}\"\n")
    list(APPEND fit_directions "&${id}::binding")
endforeach()
string(JOIN ", " fit_table ${fit_directions})
configure_file(src/Tools/CharacterFitBindings.h.in "${CMAKE_CURRENT_BINARY_DIR}/CharacterFitBindings.h" @ONLY)
target_include_directories(EmbervaleRenderPreview PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_sources(EmbervaleRenderPreview PRIVATE src/Tools/CharacterFitPreview.cpp)
target_compile_definitions(EmbervaleRenderPreview PRIVATE EMBERVALE_CHARACTER_FIT_PREVIEW)
