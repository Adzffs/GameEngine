# Build the same facing table for live play and deterministic captures.
set(fit_pilot "${CMAKE_CURRENT_SOURCE_DIR}/assets/embervale/custom-character-pilot")
# Graphics::MovementFacing returns these indices for world rendering and occlusion.
set(fit_facings south west east north south-west south-east north-west north-east)
set(fit_includes "")
set(fit_directions "")
set(fit_runtime_layers "")
set(grips_manifest "${fit_pilot}/held-items/grips.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${grips_manifest}")
file(READ "${grips_manifest}" grips_json)
foreach(direction IN LISTS fit_facings)
    set(directory "${fit_pilot}/revisions/${direction}-walk-v1")
    if(direction STREQUAL "south")
        set(directory "${fit_pilot}/revisions/shoulder-crest-v6")
    endif()
    set(manifest "${directory}/manifest.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    file(READ "${manifest}" fit_json)
    string(JSON width GET "${fit_json}" cell_size 0)
    string(JSON height GET "${fit_json}" cell_size 1)
    string(JSON pivot_x GET "${fit_json}" ground_pivot 0)
    string(JSON pivot_y GET "${fit_json}" ground_pivot 1)
    foreach(clip IN ITEMS idle walk)
        foreach(field IN ITEMS columns durations_ms)
            string(JSON length LENGTH "${fit_json}" clips ${clip} ${field})
            math(EXPR last "${length} - 1")
            set(values "")
            foreach(index RANGE ${last})
                string(JSON value GET "${fit_json}" clips ${clip} ${field} ${index})
                list(APPEND values "${value}")
            endforeach()
            string(JOIN ", " ${clip}_${field} ${values})
        endforeach()
    endforeach()
    string(JSON hand_count LENGTH "${grips_json}" ${direction})
    string(JSON idle_count LENGTH "${fit_json}" clips idle columns)
    string(JSON walk_count LENGTH "${fit_json}" clips walk columns)
    math(EXPR columns "${idle_count} + ${walk_count}")
    if(NOT hand_count EQUAL columns)
        message(FATAL_ERROR "Missing fitted hand positions for ${direction}")
    endif()
    set(hand_pairs "")
    math(EXPR last "${columns} - 1")
    foreach(i RANGE ${last})
        set(coords "")
        foreach(axis RANGE 3)
            string(JSON coord GET "${grips_json}" ${direction} ${i} ${axis})
            if(coord LESS 0 OR coord GREATER_EQUAL 80)
                message(FATAL_ERROR "Hand outside ${direction} cell ${i}")
            endif()
            list(APPEND coords "${coord}")
        endforeach()
        string(JOIN ", " coords ${coords})
        list(APPEND hand_pairs "Hands{${coords}}")
    endforeach()
    string(JOIN ", " hand_pairs ${hand_pairs})
    foreach(layer IN ITEMS body tunic full knee)
        if(layer STREQUAL "full" OR layer STREQUAL "knee")
            string(JSON relative GET "${fit_json}" pants_variants ${layer} layer)
        else()
            string(JSON relative GET "${fit_json}" ${layer})
        endif()
        file(RELATIVE_PATH ${layer} "${fit_pilot}" "${directory}/${relative}")
        list(APPEND fit_runtime_layers "${${layer}}")
    endforeach()
    if(direction STREQUAL "south")
        # Retained v6 predates the bounds field. Its measured silhouette is x=22..56, y=8..70.
        set(left 22)
        set(right 56)
        set(top 8)
        foreach(field IN ITEMS width height pivot_x pivot_y)
            set(south_${field} "${${field}}")
        endforeach()
    else()
        string(JSON left GET "${fit_json}" silhouette_bounds_inclusive 0)
        string(JSON top GET "${fit_json}" silhouette_bounds_inclusive 1)
        string(JSON right GET "${fit_json}" silhouette_bounds_inclusive 2)
        foreach(field IN ITEMS width height pivot_x pivot_y)
            if(NOT south_${field} EQUAL ${field})
                message(FATAL_ERROR "Character-fit direction ${direction} must share the south ${field}")
            endif()
        endforeach()
    endif()
    string(REPLACE "-" "_" id "${direction}")
    set(binding "CharacterFit-${direction}.inc")
    configure_file(src/Tools/CharacterFitDirection.inc.in "${CMAKE_CURRENT_BINARY_DIR}/${binding}" @ONLY)
    string(APPEND fit_includes "#include \"${binding}\"\n")
    list(APPEND fit_directions "&${id}::binding")
endforeach()
string(JOIN ", " fit_table ${fit_directions})
configure_file(src/Tools/CharacterFitBindings.h.in "${CMAKE_CURRENT_BINARY_DIR}/CharacterFitBindings.h" @ONLY)
set(catalogue_path "${fit_pilot}/held-items/catalogue.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalogue_path}")
file(READ "${catalogue_path}" catalogue)
foreach(axis RANGE 1)
    string(JSON cell_${axis} GET "${catalogue}" cell ${axis})
    string(JSON grip_${axis} GET "${catalogue}" grip ${axis})
endforeach()
string(JSON atlas_columns GET "${catalogue}" columns)
string(JSON atlas_rows GET "${catalogue}" rows)
math(EXPR atlas_cells "${atlas_columns} * ${atlas_rows}")
set(materials "")
set(palettes "")
string(JSON count LENGTH "${catalogue}" materials)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${catalogue}" materials ${i})
    list(APPEND materials "${name}")
    set(colours "")
    foreach(stop RANGE 2)
        string(JSON rgb GET "${catalogue}" materials ${name} ${stop})
        list(APPEND colours "0x${rgb}")
    endforeach()
    string(JOIN ", " colours ${colours})
    list(APPEND palettes "Palette{${colours}}")
endforeach()
string(JOIN ",\n        " palettes ${palettes})
set(shapes "")
string(JSON count LENGTH "${catalogue}" shapes)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON shape MEMBER "${catalogue}" shapes ${i})
    string(JSON length LENGTH "${catalogue}" shapes ${shape} views)
    if(NOT length EQUAL 8)
        message(FATAL_ERROR "${shape} needs eight fitted equipment view bindings")
    endif()
    set(cells "")
    foreach(view RANGE 7)
        string(JSON cell GET "${catalogue}" shapes ${shape} views ${view})
        if(cell LESS 0 OR cell GREATER_EQUAL atlas_cells)
            message(FATAL_ERROR "Invalid atlas cell for ${shape}, view ${view}")
        endif()
        list(APPEND cells "${cell}")
    endforeach()
    string(JOIN ", " cells ${cells})
    string(JSON motion GET "${catalogue}" shapes ${shape} motion)
    string(JSON mirror GET "${catalogue}" shapes ${shape} mirror_by_facing)
    if(mirror)
        set(mirror true)
    else()
        set(mirror false)
    endif()
    string(APPEND shapes "inline constexpr Shape ${shape}{{${cells}}, ${mirror}, Motion::${motion}};\n    ")
endforeach()
set(visuals "")
string(JSON count LENGTH "${catalogue}" items)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON item MEMBER "${catalogue}" items ${i})
    string(JSON shape GET "${catalogue}" items ${item} 0)
    string(JSON material GET "${catalogue}" items ${item} 1)
    list(FIND materials "${material}" palette)
    if(palette LESS 0)
        message(FATAL_ERROR "Unknown fitted material for ${item}")
    endif()
    list(APPEND visuals "Item{ItemType::${item}, ${shape}, ${palette}}")
endforeach()
string(JOIN ",\n        " visuals ${visuals})
configure_file(src/Tools/CharacterEquipmentBindings.h.in "${CMAKE_CURRENT_BINARY_DIR}/CharacterEquipmentBindings.h" @ONLY)
function(configure_character_fit target)
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    target_sources(${target} PRIVATE src/Tools/CharacterFitPreview.cpp src/Tools/CharacterHeldItems.cpp)
    target_compile_definitions(${target} PRIVATE EMBERVALE_CHARACTER_FIT)
endfunction()

list(REMOVE_DUPLICATES fit_runtime_layers)
list(APPEND fit_runtime_layers held-items/shapes.png)
add_custom_target(GameEngineCharacterLayers
    COMMAND "${CMAKE_COMMAND}" "-Dsource_root=${fit_pilot}"
        "-Doutput_root=$<TARGET_FILE_DIR:GameEngine>/assets/embervale/custom-character-pilot"
        "-Dlayer_files=${fit_runtime_layers}" -P "${CMAKE_CURRENT_LIST_DIR}/CopyCharacterFitLayers.cmake"
    VERBATIM)
