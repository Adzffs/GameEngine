# Keep this review fixture out of all gameplay and headless targets. Geometry,
# timing and the retained layer paths come from the currently reviewed manifest.
set(fit_pilot "${CMAKE_CURRENT_SOURCE_DIR}/assets/embervale/custom-character-pilot")
set(fit_revision "revisions/shoulder-crest-v6")
set(fit_manifest "${fit_pilot}/${fit_revision}/manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fit_manifest}")
file(READ "${fit_manifest}" fit_json)
string(JSON fit_width GET "${fit_json}" cell_size 0)
string(JSON fit_height GET "${fit_json}" cell_size 1)
string(JSON fit_pivot_x GET "${fit_json}" ground_pivot 0)
string(JSON fit_pivot_y GET "${fit_json}" ground_pivot 1)
foreach(clip IN ITEMS idle walk)
    foreach(field IN ITEMS columns durations_ms)
        string(JSON length LENGTH "${fit_json}" clips ${clip} ${field})
        math(EXPR last "${length} - 1")
        set(values "")
        foreach(index RANGE ${last})
            string(JSON value GET "${fit_json}" clips ${clip} ${field} ${index})
            list(APPEND values "${value}")
        endforeach()
        string(JOIN ", " fit_${clip}_${field} ${values})
    endforeach()
endforeach()
foreach(layer IN ITEMS body tunic full knee)
    if(layer STREQUAL "full" OR layer STREQUAL "knee")
        string(JSON relative GET "${fit_json}" pants_variants ${layer} layer)
    else()
        string(JSON relative GET "${fit_json}" ${layer})
    endif()
    file(RELATIVE_PATH fit_${layer} "${fit_pilot}" "${fit_pilot}/${fit_revision}/${relative}")
endforeach()
configure_file(src/Tools/CharacterFitBindings.h.in "${CMAKE_CURRENT_BINARY_DIR}/CharacterFitBindings.h" @ONLY)
target_include_directories(EmbervaleRenderPreview PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_sources(EmbervaleRenderPreview PRIVATE src/Tools/CharacterFitPreview.cpp)
target_compile_definitions(EmbervaleRenderPreview PRIVATE EMBERVALE_CHARACTER_FIT_PREVIEW)
